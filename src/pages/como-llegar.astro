---
import BaseLayout from "../layouts/BaseLayout.astro";
import { casa } from "../data/casa";
import { lodgingBusinessLd } from "../lib/schema";
import parqueEntrada from "../assets/fotos/parque-nacional-entrada.jpg";

const title = "Cómo llegar | Cabaña a 2 km del Parque Nacional Lago Puelo";
const description =
  "Ubicación de Lejana Casa de Montaña: a 2 km del Parque Nacional Lago Puelo, 3,2 km del centro, 16 km de El Bolsón y 145 km del aeropuerto de Bariloche.";

/** Preferir coordenadas exactas: la búsqueda por dirección en Google apunta mal. */
const mapsQuery = casa.geo
  ? `${casa.geo.lat},${casa.geo.lng}`
  : encodeURIComponent(casa.direccion.completa);
const mapsEmbed = `https://www.google.com/maps?q=${mapsQuery}&z=17&output=embed`;
const mapsLink =
  casa.contacto.googleMaps ??
  (casa.geo
    ? `https://www.google.com/maps?q=${casa.geo.lat},${casa.geo.lng}`
    : `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`);
---

<BaseLayout
  title={title}
  description={description}
  path="/como-llegar"
  ogImage={parqueEntrada}
  jsonLd={lodgingBusinessLd()}
  breadcrumbs={[
    { name: "Inicio", path: "/" },
    { name: "Cómo llegar", path: "/como-llegar" },
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h1 class="text-3xl md:text-5xl">Ubicación y cómo llegar</h1>
    <p class="mt-4 max-w-2xl text-lg text-tierra/90">
      Lejana Casa de Montaña está en Lago Puelo, Chubut, a {casa.distancias.parqueNacionalKm}{" "}
      km del Parque Nacional y a {casa.distancias.lagoPueloKm} km del centro, en un claro de
      bosque nativo ({casa.direccion.completa}).
    </p>

    <div class="mt-10 aspect-[16/10] w-full overflow-hidden border border-crema-oscura bg-crema-oscura">
      <iframe
        title={`Mapa de ${casa.nombre}`}
        src={mapsEmbed}
        class="h-full w-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      >
      </iframe>
    </div>
    <p class="mt-3 text-sm">
      <a
        href={mapsLink}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-bosque underline-offset-2 hover:underline"
      >
        Abrir en Google Maps
      </a>
      <span class="todo-banner ml-2">
        TODO: crear/corregir la ficha oficial en Google Maps (el pin “Cabaña Lejana” del
        otro lado de la calle es incorrecto)
      </span>
    </p>

    <section class="mt-14" aria-labelledby="distancias">
      <h2 id="distancias" class="text-2xl md:text-3xl">Distancias útiles</h2>
      <p class="mt-3 max-w-2xl text-tierra/90">
        Estás a {casa.distancias.parqueNacionalKm} km del Parque Nacional Lago Puelo y a{" "}
        {casa.distancias.lagoPueloKm} km del centro del pueblo.
      </p>
      <ul class="mt-6 grid list-none gap-4 p-0 sm:grid-cols-2">
        <li class="border border-crema-oscura bg-crema/50 p-5">
          Parque Nacional Lago Puelo: {casa.distancias.parqueNacionalKm} km
        </li>
        <li class="border border-crema-oscura bg-crema/50 p-5">
          Centro de Lago Puelo: {casa.distancias.lagoPueloKm} km
        </li>
        <li class="border border-crema-oscura bg-crema/50 p-5">
          Restaurantes: {casa.distancias.restaurantesKm} km
        </li>
        <li class="border border-crema-oscura bg-crema/50 p-5">
          Ruta 16: unos {casa.distancias.ruta16m} m
        </li>
        <li class="border border-crema-oscura bg-crema/50 p-5">
          El Bolsón:{" "}
          {casa.distancias.elBolsonKm != null
            ? `${casa.distancias.elBolsonKm} km`
            : "TODO: confirmar distancia"}
        </li>
        <li class="border border-crema-oscura bg-crema/50 p-5">
          Aeropuerto de Bariloche:{" "}
          {casa.distancias.aeropuertoBarilocheKm != null
            ? `${casa.distancias.aeropuertoBarilocheKm} km`
            : "TODO: confirmar distancia"}
        </li>
      </ul>
    </section>

    <section class="mt-14 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-2xl md:text-3xl">Desde Bariloche</h2>
        <p class="mt-3 text-tierra/90">
          La forma habitual es llegar al aeropuerto de Bariloche y seguir por ruta hacia la
          Comarca Andina hasta Lago Puelo. Son unos {casa.distancias.aeropuertoBarilocheKm} km
          hasta la casa.
        </p>
        <p class="todo-banner mt-3">
          TODO: confirmar tiempo de viaje estimado y tip de acceso final a la propiedad
        </p>
      </div>
      <div>
        <h2 class="text-2xl md:text-3xl">Desde El Bolsón</h2>
        <p class="mt-3 text-tierra/90">
          Desde El Bolsón se llega a Lago Puelo por la Comarca Andina. Lejana Casa de Montaña
          queda a unos {casa.distancias.elBolsonKm} km, a {casa.distancias.parqueNacionalKm} km
          del Parque Nacional.
        </p>
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl md:text-3xl">Acceso</h2>
      <p class="mt-3 max-w-2xl text-tierra/90">
        El acceso es por zona de bosque nativo, a unos {casa.distancias.ruta16m} m de la Ruta
        16. La casa está en un claro (no es un patio cerrado). Se pueden dejar hasta 4 autos
        al lado de la casa; no hay cochera techada.
      </p>
    </section>
  </div>
</BaseLayout>
