---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Gallery from "../components/Gallery.astro";
import ScoreBadges from "../components/ScoreBadges.astro";
import PhotoBand from "../components/PhotoBand.astro";
import { casa, whatsappUrl } from "../data/casa";
import { lodgingBusinessLd } from "../lib/schema";
import hero from "../assets/fotos/exterior-frente-montana.jpg";
import exteriorClaro from "../assets/fotos/exterior-claro.jpg";
import exteriorNoche from "../assets/fotos/exterior-noche-gente.jpg";
import interiorSalon from "../assets/fotos/interior-salon.jpg";
import interiorCocina from "../assets/fotos/interior-cocina.jpg";
import dormitorioMatri from "../assets/fotos/dormitorio-matrimonial.jpg";
import dormitorioCucheta from "../assets/fotos/dormitorio-cucheta.jpg";
import hidromasajeVista from "../assets/fotos/hidromasaje-vista.jpg";
import exteriorPorche from "../assets/fotos/exterior-porche.jpg";
import paisajeRioValle from "../assets/fotos/paisaje-rio-valle.jpg";
import paisajeKayak from "../assets/fotos/paisaje-kayak.jpg";
import parqueEntrada from "../assets/fotos/parque-nacional-entrada.jpg";

const title = "Lejana Casa de Montaña | Cabaña en Lago Puelo, Patagonia";
const description =
  "Cabaña nueva para 5 personas en un claro de bosque nativo, a 2 km del Parque Nacional Lago Puelo. Quincho, hidromasaje y descanso en la Comarca Andina.";

const wa = whatsappUrl();
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  ogImage={hero}
  jsonLd={lodgingBusinessLd()}
  breadcrumbs={[{ name: "Inicio", path: "/" }]}
>
  <section class="relative min-h-[85vh] w-full overflow-hidden">
    <Image
      src={hero}
      alt="Lejana Casa de Montaña de frente, con la montaña detrás, en Lago Puelo"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
      format="webp"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-bosque-oscuro/80 via-bosque-oscuro/25 to-black/10"
    >
    </div>
    <div
      class="relative mx-auto flex min-h-[85vh] max-w-6xl flex-col justify-end px-4 pb-16 pt-28 md:pb-20"
    >
      <p class="font-display text-4xl text-crema md:text-6xl lg:text-7xl">
        {casa.nombre}
      </p>
      <h1 class="mt-4 max-w-2xl text-xl font-normal text-crema/95 md:text-2xl">
        {casa.propuesta}
      </h1>
      <p class="mt-4 max-w-xl text-crema/90">
        Cabaña para 5 personas en Lago Puelo, Chubut: 120 m², quincho de 45 m² e
        hidromasaje, en 1.800 m² de bosque nativo a 2 km del Parque Nacional.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={wa ?? "/contacto"}
          class="inline-flex items-center rounded-sm bg-crema px-5 py-3 text-sm font-semibold text-bosque-oscuro no-underline transition hover:bg-white"
          {...(wa ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          Consultar por WhatsApp
        </a>
        <a
          href="/la-casa"
          class="inline-flex items-center rounded-sm border border-crema/70 px-5 py-3 text-sm font-semibold text-crema no-underline transition hover:bg-crema/10"
        >
          Ver la casa
        </a>
      </div>
      {
        !wa && (
          <p class="todo-banner mt-4 max-w-md">
            TODO: confirmar número de WhatsApp para activar el enlace directo
          </p>
        )
      }
    </div>
  </section>

  <PhotoBand image={paisajeKayak} wash="medium">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-2xl md:text-3xl">¿Por qué elegir esta cabaña en Lago Puelo?</h2>
      <p class="mt-3 max-w-2xl text-tierra/90">
        Porque es una casa nueva en un claro del bosque, completa y tranquila, a{" "}
        {casa.distancias.parqueNacionalKm} km del Parque Nacional Lago Puelo.
      </p>
      <ul class="mt-10 grid list-none gap-8 p-0 md:grid-cols-3">
        <li>
          <h3 class="text-xl">Claro en el bosque</h3>
          <p class="mt-2 text-tierra/90">{casa.entorno}</p>
        </li>
        <li>
          <h3 class="text-xl">Para 5 personas</h3>
          <p class="mt-2 text-tierra/90">
            Ideal para familias o parejas: {casa.dormitorios} dormitorios,{" "}
            {casa.camas.resumen}, cocina equipada, quincho e hidromasaje.
          </p>
        </li>
        <li>
          <h3 class="text-xl">Cerca del Parque Nacional</h3>
          <p class="mt-2 text-tierra/90">
            A {casa.distancias.parqueNacionalKm} km del Parque Nacional Lago Puelo, a{" "}
            {casa.distancias.lagoPueloKm} km del centro y a {casa.distancias.elBolsonKm} km
            de El Bolsón.
          </p>
        </li>
      </ul>
    </div>
  </PhotoBand>

  <div class="py-8">
    <Gallery
      items={[
        {
          image: hero,
          alt: "Fachada de Lejana Casa de Montaña con la montaña al fondo",
        },
        {
          image: exteriorNoche,
          alt: "Entrada de la cabaña de noche, con luces cálidas",
        },
        {
          image: interiorSalon,
          alt: "Living y comedor de troncos en Lejana Casa de Montaña",
        },
        {
          image: interiorCocina,
          alt: "Cocina equipada de la cabaña en Lago Puelo",
        },
        {
          image: dormitorioMatri,
          alt: "Dormitorio con cama matrimonial",
        },
        {
          image: dormitorioCucheta,
          alt: "Dormitorio con cama cucheta y cama individual",
        },
        {
          image: hidromasajeVista,
          alt: "Bañera con hidromasaje interior y vista al bosque",
        },
        {
          image: exteriorPorche,
          alt: "Porche con mecedoras en la entrada de la cabaña",
        },
        {
          image: exteriorClaro,
          alt: "Claro en el bosque alrededor de la casa",
        },
        {
          image: parqueEntrada,
          alt: "Entrada al Parque Nacional Lago Puelo, a 2 km",
        },
      ]}
    />
  </div>

  <div class="py-16 md:py-20">
    <ScoreBadges />
  </div>

  <PhotoBand image={paisajeRioValle} wash="light">
    <div class="mx-auto max-w-6xl px-4">
      <div class="border border-crema-oscura/80 bg-crema/75 px-6 py-10 backdrop-blur-[2px] md:px-10">
        <h2 class="text-2xl md:text-3xl">¿Querés desconectar en Lago Puelo?</h2>
        <p class="mt-3 max-w-2xl text-tierra/90">
          Escribinos por WhatsApp para consultar fechas. También podés reservar por Airbnb o
          Booking si preferís las plataformas.
        </p>
        {
          casa.beneficioReservaDirecta ? (
            <p class="mt-3 text-tierra/90">{casa.beneficioReservaDirecta}</p>
          ) : (
            <p class="todo-banner">
              TODO: confirmar beneficio por reserva directa (ej. salida más tarde o leña de
              regalo), no un precio más bajo que en las plataformas
            </p>
          )
        }
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={wa ?? "/contacto"}
            class="inline-flex rounded-sm bg-bosque px-5 py-3 text-sm font-semibold text-crema no-underline hover:bg-bosque-oscuro"
            {...(wa ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            WhatsApp
          </a>
          <a
            href={casa.puntajes.airbnb.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex rounded-sm border border-bosque/40 px-5 py-3 text-sm font-semibold text-bosque-oscuro no-underline hover:bg-crema-oscura"
          >
            Airbnb
          </a>
          <a
            href={casa.puntajes.booking.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex rounded-sm border border-bosque/40 px-5 py-3 text-sm font-semibold text-bosque-oscuro no-underline hover:bg-crema-oscura"
          >
            Booking
          </a>
        </div>
      </div>
    </div>
  </PhotoBand>
</BaseLayout>
