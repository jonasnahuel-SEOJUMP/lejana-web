---
/**
 * Franja con foto de paisaje suave detrás de un bloque de contenido.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  /** Más alto = más crema, menos foto visible */
  wash?: "light" | "medium";
}

const { image, wash = "medium" } = Astro.props;
const washClass = wash === "light" ? "photo-band__wash--light" : "photo-band__wash--medium";
---

<section class="photo-band relative overflow-hidden py-16 md:py-20">
  <div class="photo-band__bg" aria-hidden="true">
    <Image
      src={image}
      alt=""
      widths={[800, 1400]}
      sizes="100vw"
      class="photo-band__img"
      loading="lazy"
      format="webp"
      quality={60}
    />
    <div class:list={["photo-band__wash", washClass]}></div>
  </div>
  <div class="relative z-10">
    <slot />
  </div>
</section>

<style>
  .photo-band__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .photo-band__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    filter: blur(1px) saturate(0.95) brightness(1.02);
  }

  .photo-band__wash {
    position: absolute;
    inset: 0;
  }

  .photo-band__wash--medium {
    background: color-mix(in srgb, var(--color-crema) 42%, transparent);
  }

  .photo-band__wash--light {
    background: color-mix(in srgb, var(--color-crema) 35%, transparent);
  }
</style>
