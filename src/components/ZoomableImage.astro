---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  image,
  alt,
  widths = [400, 700, 1000],
  sizes = "100vw",
  class: className = "h-56 w-full object-cover",
  loading = "lazy",
  fetchpriority,
} = Astro.props;

const full = await getImage({
  src: image,
  width: 1800,
  format: "webp",
  quality: 82,
});
---

<button
  type="button"
  class="lightbox-trigger block w-full cursor-zoom-in border-0 bg-transparent p-0 text-left"
  data-lightbox-src={full.src}
  data-lightbox-alt={alt}
  aria-label={`Ampliar foto: ${alt}`}
>
  <Image
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    class={className}
    loading={loading}
    format="webp"
    {...(fetchpriority ? { fetchpriority } : {})}
  />
</button>
