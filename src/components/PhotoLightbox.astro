---
/**
 * Lightbox global: cualquier botón/enlace con data-lightbox-src abre la foto ampliada.
 */
---

<dialog
  id="photo-lightbox"
  class="photo-lightbox m-0 max-h-none max-w-none border-0 bg-transparent p-0 text-crema backdrop:bg-bosque-oscuro/90"
  aria-label="Foto ampliada"
>
  <div class="flex min-h-screen w-screen flex-col items-center justify-center px-3 py-14 md:px-8">
    <button
      type="button"
      class="photo-lightbox__close absolute right-3 top-3 z-10 rounded-sm bg-crema px-3 py-2 text-sm font-semibold text-bosque-oscuro md:right-6 md:top-6"
      data-lightbox-close
    >
      Cerrar
    </button>
    <img
      data-lightbox-image
      src=""
      alt=""
      class="max-h-[85vh] max-w-full object-contain shadow-lg"
    />
    <p
      data-lightbox-caption
      class="mt-4 max-w-3xl px-2 text-center text-sm text-crema/90"
    >
    </p>
  </div>
</dialog>

<style>
  .photo-lightbox[open] {
    display: flex;
  }

  .photo-lightbox::backdrop {
    background: color-mix(in srgb, var(--color-bosque-oscuro) 90%, transparent);
  }
</style>

<script>
  const w = window as Window & { __lejanaLightboxReady?: boolean };
  if (!w.__lejanaLightboxReady) {
    w.__lejanaLightboxReady = true;

    document.addEventListener("click", (event) => {
      const dialog = document.getElementById("photo-lightbox");
      if (!(dialog instanceof HTMLDialogElement)) return;

      const image = dialog.querySelector("[data-lightbox-image]");
      const caption = dialog.querySelector("[data-lightbox-caption]");
      if (!(image instanceof HTMLImageElement) || !(caption instanceof HTMLElement)) return;

      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest("[data-lightbox-close]")) {
        dialog.close();
        return;
      }

      const trigger = target.closest("[data-lightbox-src]");
      if (trigger instanceof HTMLElement) {
        event.preventDefault();
        const src = trigger.getAttribute("data-lightbox-src");
        const alt = trigger.getAttribute("data-lightbox-alt") ?? "";
        if (!src) return;
        image.src = src;
        image.alt = alt;
        caption.textContent = alt;
        if (!dialog.open) dialog.showModal();
      }
    });

    document.addEventListener("click", (event) => {
      const dialog = document.getElementById("photo-lightbox");
      if (!(dialog instanceof HTMLDialogElement) || !dialog.open) return;
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener(
      "close",
      (event) => {
        if (!(event.target instanceof HTMLDialogElement)) return;
        if (event.target.id !== "photo-lightbox") return;
        const image = event.target.querySelector("[data-lightbox-image]");
        const caption = event.target.querySelector("[data-lightbox-caption]");
        if (image instanceof HTMLImageElement) {
          image.removeAttribute("src");
          image.alt = "";
        }
        if (caption instanceof HTMLElement) caption.textContent = "";
      },
      true,
    );
  }
</script>
