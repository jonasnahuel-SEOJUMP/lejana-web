---
/**
 * Lightbox global: cualquier botón/enlace con data-lightbox-src abre la foto ampliada.
 * Se cierra con el botón X, Escape, o tocando la foto / el fondo.
 */
---

<dialog
  id="photo-lightbox"
  class="photo-lightbox m-0 max-h-none max-w-none border-0 bg-transparent p-0 text-crema backdrop:bg-bosque-oscuro/90"
  aria-label="Foto ampliada"
>
  <div
    class="photo-lightbox__panel relative flex min-h-[100dvh] w-screen flex-col items-center justify-center px-3 pb-10 pt-16 md:px-8"
    data-lightbox-dismiss
  >
    <button
      type="button"
      class="photo-lightbox__close absolute right-3 top-3 z-20 flex min-h-12 min-w-12 items-center justify-center rounded-sm bg-crema px-4 py-3 text-base font-semibold text-bosque-oscuro shadow-md md:right-6 md:top-6"
      data-lightbox-close
      aria-label="Cerrar foto"
    >
      Cerrar ✕
    </button>
    <img
      data-lightbox-image
      src=""
      alt=""
      class="max-h-[80dvh] max-w-full cursor-zoom-out object-contain shadow-lg"
    />
    <p
      data-lightbox-caption
      class="mt-4 max-w-3xl px-2 text-center text-sm text-crema/90"
    >
    </p>
    <p class="mt-2 text-center text-xs text-crema/70">
      Tocá la foto o afuera para cerrar
    </p>
  </div>
</dialog>

<style>
  .photo-lightbox[open] {
    display: flex;
  }

  .photo-lightbox::backdrop {
    background: color-mix(in srgb, var(--color-bosque-oscuro) 90%, transparent);
  }

  :global(body.lightbox-open .whatsapp-fab) {
    visibility: hidden;
    pointer-events: none;
  }
</style>

<script>
  const w = window as Window & { __lejanaLightboxReady?: boolean };
  if (!w.__lejanaLightboxReady) {
    w.__lejanaLightboxReady = true;

    function getDialog(): HTMLDialogElement | null {
      const dialog = document.getElementById("photo-lightbox");
      return dialog instanceof HTMLDialogElement ? dialog : null;
    }

    function getParts(dialog: HTMLDialogElement) {
      const image = dialog.querySelector("[data-lightbox-image]");
      const caption = dialog.querySelector("[data-lightbox-caption]");
      if (!(image instanceof HTMLImageElement) || !(caption instanceof HTMLElement)) {
        return null;
      }
      return { image, caption };
    }

    function openLightbox(src: string, alt: string) {
      const dialog = getDialog();
      if (!dialog) return;
      const parts = getParts(dialog);
      if (!parts) return;
      parts.image.src = src;
      parts.image.alt = alt;
      parts.caption.textContent = alt;
      if (!dialog.open) {
        dialog.showModal();
        document.body.classList.add("lightbox-open");
      }
    }

    function closeLightbox() {
      const dialog = getDialog();
      if (!dialog?.open) return;
      dialog.close();
    }

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest("[data-lightbox-close]")) {
        event.preventDefault();
        closeLightbox();
        return;
      }

      const dialog = getDialog();
      if (dialog?.open) {
        // Cerrar al tocar fondo, imagen o el panel (salvo el botón, ya manejado)
        if (target.closest("#photo-lightbox")) {
          event.preventDefault();
          closeLightbox();
          return;
        }
      }

      const trigger = target.closest("[data-lightbox-src]");
      if (trigger instanceof HTMLElement) {
        event.preventDefault();
        const src = trigger.getAttribute("data-lightbox-src");
        const alt = trigger.getAttribute("data-lightbox-alt") ?? "";
        if (!src) return;
        openLightbox(src, alt);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      closeLightbox();
    });

    document.addEventListener(
      "close",
      (event) => {
        if (!(event.target instanceof HTMLDialogElement)) return;
        if (event.target.id !== "photo-lightbox") return;
        document.body.classList.remove("lightbox-open");
        const parts = getParts(event.target);
        if (!parts) return;
        parts.image.removeAttribute("src");
        parts.image.alt = "";
        parts.caption.textContent = "";
      },
      true,
    );
  }
</script>
