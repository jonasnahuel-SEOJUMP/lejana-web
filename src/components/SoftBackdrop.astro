---
/**
 * Fondo fotográfico suave detrás de todo el sitio.
 * Difuminado + velo crema para que los textos se lean bien.
 */
import { Image } from "astro:assets";
import fondoPaisaje from "../assets/fotos/paisaje-rio-valle.jpg";
---

<div class="site-backdrop" aria-hidden="true">
  <Image
    src={fondoPaisaje}
    alt=""
    widths={[800, 1200, 1600]}
    sizes="100vw"
    class="site-backdrop__img"
    loading="eager"
    format="webp"
    quality={55}
  />
  <div class="site-backdrop__wash"></div>
</div>

<style>
  .site-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .site-backdrop__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    filter: blur(1px) saturate(0.95) brightness(1.02);
  }

  .site-backdrop__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-crema) 48%, transparent) 0%,
        color-mix(in srgb, var(--color-crema) 52%, transparent) 45%,
        color-mix(in srgb, var(--color-crema) 58%, transparent) 100%
      );
  }

  @media (prefers-reduced-motion: reduce) {
    .site-backdrop__img {
      filter: blur(0.5px) saturate(0.9) brightness(1.02);
    }
  }
</style>
