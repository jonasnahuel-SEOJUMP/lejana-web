---
import { whatsappUrl } from "../data/casa";
const wa = whatsappUrl();
const href = wa ?? "/contacto";
const label = wa ? "Escribir por WhatsApp" : "Consultar (WhatsApp pendiente)";
---

{
  wa ? (
    <a
      href={href}
      class="fixed bottom-4 right-4 z-50 inline-flex items-center gap-2 rounded-sm bg-[#1f6b45] px-4 py-3 text-sm font-semibold text-white shadow-lg no-underline transition hover:bg-[#185536] md:bottom-6 md:right-6"
      aria-label={label}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span aria-hidden="true" class="text-lg">
        ✆
      </span>
      <span class="hidden sm:inline">{label}</span>
      <span class="sm:hidden">WhatsApp</span>
    </a>
  ) : (
    <a
      href={href}
      class="fixed bottom-4 right-4 z-50 inline-flex items-center gap-2 rounded-sm bg-[#1f6b45] px-4 py-3 text-sm font-semibold text-white shadow-lg no-underline transition hover:bg-[#185536] md:bottom-6 md:right-6"
      aria-label={label}
    >
      <span aria-hidden="true" class="text-lg">
        ✆
      </span>
      <span class="hidden sm:inline">{label}</span>
      <span class="sm:hidden">WhatsApp</span>
    </a>
  )
}
