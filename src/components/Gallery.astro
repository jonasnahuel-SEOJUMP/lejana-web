---
import type { ImageMetadata } from "astro";
import ZoomableImage from "./ZoomableImage.astro";

interface Item {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section aria-labelledby="galeria-title" class="mx-auto max-w-6xl px-4">
  <h2 id="galeria-title" class="text-2xl md:text-3xl">Galería</h2>
  <p class="mt-3 max-w-2xl text-tierra/90">
    Fotos reales de la cabaña, el hidromasaje, el claro en el bosque y Lago Puelo. Tocá una
    foto para ampliarla.
  </p>
  <ul class="mt-8 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => (
        <li class="overflow-hidden bg-crema-oscura">
          <ZoomableImage
            image={item.image}
            alt={item.alt}
            widths={[400, 700, 1000]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
            class="h-56 w-full object-cover transition duration-300 group-hover:opacity-95 md:h-64"
          />
        </li>
      ))
    }
  </ul>
</section>
